# LLM Configuration: "gemini" or "openai" or "mock"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
MODEL_NAME=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# xAI / Grok Fallback LLM Provider
XAI_API_KEY=
XAI_MODEL=grok-4.1-fast
XAI_BASE_URL=https://api.x.ai/v1

# Authentication
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database
DATABASE_URL=sqlite:///./data/memorybot.db

# Context Window & Memory
MAX_CONTEXT_MESSAGES=20
SUMMARY_TRIGGER_THRESHOLD=14

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Real-Time Web Search & APIs (Zara)
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=your_key_here
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=10
